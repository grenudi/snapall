# PCManFM and PCManFM-Qt (libfm actions). Installed in /usr/share/file-manager/actions/. Files only.
# PCManFM-Qt reads actions at start, so restart it after installing.
[Desktop Entry]
Type=Action
Name=Restore from snapshots
Icon=snapall
Profiles=snapall;

[X-Action-Profile snapall]
MimeTypes=all/allfiles;
Exec=snapall-file-menu %f
