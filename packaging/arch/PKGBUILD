# Maintainer: grenudi <17498075+grenudi@users.noreply.github.com>
#
# Builds snapall from a release tag. The release workflow publishes this file with `pkgver`
# and `sha256sums` filled in; CI builds it from the checked-out commit by overriding
# `_source` and `_dir` (see packaging/test/install-package.sh).

pkgname=snapall
pkgver=0.1.0
pkgrel=1
pkgdesc='Snapshot every snapper config in one command, from the CLI or a terminal UI'
arch=('x86_64' 'aarch64')
url='https://github.com/grenudi/snapall'
license=('GPL-3.0-or-later')
depends=('snapper')
makedepends=('cargo' 'python')
_dir="${_dir:-$pkgname-$pkgname-v$pkgver}"
source=("${_source:-$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgname-v$pkgver.tar.gz}")
sha256sums=('SKIP')

prepare() {
  cd "$_dir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_dir"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p snapall
}

check() {
  cd "$_dir"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$_dir"
  install -Dm755 target/release/snapall -t "$pkgdir/usr/bin/"
  # The binary contains MIT/Apache libraries; their notices travel with it.
  python packaging/third-party-licenses.py "$(rustc -vV | sed -n 's/host: //p')"
  install -Dm644 LICENSE THIRD-PARTY-LICENSES.md -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  # Completions and the man page come from the contract the binary was built with.
  # (makepkg sets SOURCE_DATE_EPOCH, so the man page date is reproducible.)
  target/release/snapall completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  target/release/snapall completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
  target/release/snapall completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"
  target/release/snapall completions nushell | install -Dm644 /dev/stdin "$pkgdir/usr/share/nushell/vendor/autoload/$pkgname.nu"
  target/release/snapall man | gzip -9n | install -Dm644 /dev/stdin "$pkgdir/usr/share/man/man1/$pkgname.1.gz"
}
