[Desktop Entry]
Type=Application
Version=1.1
Name=snapall
GenericName=Snapshot Manager
Comment=Take, browse, restore and delete system snapshots
Keywords=snapshot;snapshots;snapper;btrfs;backup;restore;rollback;undo;
# A terminal with sudo: snapper needs root, and the terminal is where sudo can ask for the
# password, in every desktop environment.
Exec=sudo snapall tui
TryExec=snapall
Icon=snapall
Terminal=true
Categories=System;Filesystem;
StartupNotify=false
